# Copy to .env and fill in. Never commit real values.

# --- Optional: better captions via Claude ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- GitHub Pages image hosting (gives each card a public image_url) ---
# GITHUB_USER=your-github-username
# GITHUB_PAGES_REPO=science-instagram-cards   # optional; this default is fine

# --- Instagram Graph API credentials, ONE PAIR PER ACCOUNT ---
# Naming: IG_USER_ID__<ACCOUNT> and IG_TOKEN__<ACCOUNT> (account UPPER-CASED).
# Get these after converting to a Business account + Meta app + App Review.
#
# Topic accounts:
# IG_USER_ID__CHEMISTRYNEWS=
# IG_TOKEN__CHEMISTRYNEWS=
# IG_USER_ID__BIOLOGYNEWS=
# IG_TOKEN__BIOLOGYNEWS=
# IG_USER_ID__PHYSICSNEWS=
# IG_TOKEN__PHYSICSNEWS=
# IG_USER_ID__QUANTUMNEWS=
# IG_TOKEN__QUANTUMNEWS=
# IG_USER_ID__ENVIRONMENTALNEWS=
# IG_TOKEN__ENVIRONMENTALNEWS=
# IG_USER_ID__SPACENEWS=
# IG_TOKEN__SPACENEWS=
# IG_USER_ID__NEURONEWS=
# IG_TOKEN__NEURONEWS=
# IG_USER_ID__MEDICINENEWS=
# IG_TOKEN__MEDICINENEWS=
# IG_USER_ID__AINEWS=
# IG_TOKEN__AINEWS=
# IG_USER_ID__PSYCHNEWS=
# IG_TOKEN__PSYCHNEWS=
# IG_USER_ID__MATHNEWS=
# IG_TOKEN__MATHNEWS=
#
# Institution accounts:
# IG_USER_ID__RESEARCHATCALTECH=
# IG_TOKEN__RESEARCHATCALTECH=
# IG_USER_ID__RESEARCHATSTANFORD=
# IG_TOKEN__RESEARCHATSTANFORD=
